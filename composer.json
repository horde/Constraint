{
    "minimum-stability": "dev",
    "name": "horde/constraint",
    "description": "Modern constraint library for evaluating values against rules",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Constraint",
    "license": "BSD-2-Clause",
    "keywords": ["constraint", "validation", "rules", "horde"],
    "authors": [
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        },
        {
            "name": "James Pepin",
            "email": "james@jamespepin.com",
            "role": "developer"
        }
    ],
    "time": "2022-11-05",
    "repositories": [
        {
            "type": "composer",
            "url": "https://horde-satis.maintaina.com"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {},
    "autoload": {
        "psr-0": {
            "Horde_Constraint": "lib/"
        },
        "psr-4": {
            "Horde\\Constraint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Constraint\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    }
}